-- level rows
local levelOn = { false, false }
local rows = {}

local function refresh()
	local want = {}
	for i, on in levelOn do
		if on then
			for f in LEVELS[i].features do
				want[f] = true
			end
		end
	end
	for _, f in FEATURES do
		if want[f] and not active[f] then
			activate(f)
		elseif not want[f] and active[f] then
			deactivate(f)
		end
	end

	local top = 0
	for i, on in levelOn do
		local r = rows[i]
		local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad)
		TweenService:Create(r.switch, info, {
			BackgroundColor3 = on and Color3.fromRGB(110, 70, 240) or Color3.fromRGB(50, 50, 82),
		}):Play()
		TweenService:Create(r.knob, info, {
			Position = on and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		}):Play()
		if on then
			top = math.max(top, LEVELS[i].pct)
		end
	end
	mainBtn.Text = top > 0 and ("OPTIMIZED (" .. top .. "%)") or "OPTIMIZE (0%)"
end


-- dragging (panel from any empty area, tab by holding and moving; tap on tab opens/closes)
local drag = nil

local function makeDraggable(target, handle, onTap)
	handle.InputBegan:Connect(function(input)
		if
			input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end
		local d = {
			target = target,
			input = input,
			start = input.Position,
			pos = target.Position,
			center = target.AbsolutePosition + target.AbsoluteSize / 2,
			moved = false,
		}
		drag = d
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				if drag == d then
					drag = nil
				end
				if onTap and not d.moved then
					onTap()
				end
			end
		end)
	end)
end

UserInputService.InputChanged:Connect(function(input)
	if not drag then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= drag.input then
		return
	end
	local delta = input.Position - drag.start
	if not drag.moved then
		if delta.Magnitude < 8 then
			return
		end
		drag.moved = true
	end
	local view = gui.AbsoluteSize
	local cx = math.clamp(drag.center.X + delta.X, 0, view.X)
	local cy = math.clamp(drag.center.Y + delta.Y, 0, view.Y)
	local dx = cx - drag.center.X
	local dy = cy - drag.center.Y
	drag.target.Position = UDim2.new(
		drag.pos.X.Scale,
		drag.pos.X.Offset + dx,
		drag.pos.Y.Scale,
		drag.pos.Y.Offset + dy
	)
end)

makeDraggable(panel, panel, nil)

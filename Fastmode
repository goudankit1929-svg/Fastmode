		features = { texture = true, animation = true, effects = true, motion = true, everything = true },
	},
}

local active, gen, saved, parked = {}, {}, {}, {}
for _, f in FEATURES do
	active[f] = false
	gen[f] = 0
	saved[f] = {}
	parked[f] = {}
end

local animators = {}
local terrainColors = nil
local savedQuality = nil

local function set(f, inst, prop, value)
	pcall(function()
		local rec = saved[f][inst]
		if not rec then
			rec = {}
			saved[f][inst] = rec
		end
		if rec[prop] == nil then
			rec[prop] = inst[prop]
		end
		inst[prop] = value
	end)
end

local function park(f, inst)
	pcall(function()
		if parked[f][inst] == nil and inst.Parent then
			parked[f][inst] = inst.Parent
			inst.Parent = nil
		end
	end)
end

local handlers = {}

function handlers.texture(i)
	if i:IsA("Decal") then
		set("texture", i, "Transparency", 1)
	elseif i:IsA("SurfaceAppearance") then
		park("texture", i)
	elseif i:IsA("MeshPart") then
		set("texture", i, "TextureID", "")
		set("texture", i, "Material", Enum.Material.SmoothPlastic)
	elseif i:IsA("SpecialMesh") then
		set("texture", i, "TextureId", "")
	elseif i:IsA("BasePart") and not i:IsA("Terrain") then
		set("texture", i, "Material", Enum.Material.SmoothPlastic)
	end
end

function handlers.animation(i)
	if i:IsA("Animator") then
		animators[i] = true
	end
end

function handlers.effects(i)
	if
		i:IsA("ParticleEmitter")
		or i:IsA("Trail")
		or i:IsA("Beam")
		or i:IsA("Fire")
		or i:IsA("Smoke")
		or i:IsA("Sparkles")
		or i:IsA("Light")
		or i:IsA("Highlight")
		or i:IsA("PostEffect")
		or i:IsA("Clouds")
	then
		set("effects", i, "Enabled", false)
	elseif i:IsA("Atmosphere") then
		set("effects", i, "Density", 0)
		set("effects", i, "Haze", 0)
		set("effects", i, "Glare", 0)
	elseif i:IsA("BasePart") and not i:IsA("Terrain") then
		set("effects", i, "CastShadow", false)
	end
end

function handlers.motion(i)
	if i:IsA("ParticleEmitter") then
		set("motion", i, "Speed", NumberRange.new(0))
		set("motion", i, "Acceleration", Vector3.zero)
	elseif i:IsA("Beam") then
		set("motion", i, "TextureSpeed", 0)
	elseif i:IsA("Smoke") then
		set("motion", i, "RiseVelocity", 0)
	end
end

function handlers.everything(i)
	if i:IsA("Sky") or i:IsA("Clothing") or i:IsA("ShirtGraphic") or i:IsA("CharacterMesh") then
		park("everything", i)
	elseif i:IsA("BasePart") and not i:IsA("Terrain") then
		set("everything", i, "Color", WHITE)
		set("everything", i, "Reflectance", 0)
		if i:IsA("PartOperation") then
			set("everything", i, "UsePartColor", true)
		end
	end
end

local animConn = nil
local globals = {}

globals.texture = {
	on = function()
		set("texture", terrain, "Decoration", false)
	end,
	off = function() end,
}

globals.animation = {
	on = function()
		local acc = 0
		animConn = RunService.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 0.1 then
				return
			end
			acc = 0
			for a in animators do
				if a.Parent then
					for _, t in a:GetPlayingAnimationTracks() do
						pcall(function()
							t:Stop(0)
						end)
					end
				else
					animators[a] = nil
				end
			end
		end)
	end,
	off = function()
		if animConn then
			animConn:Disconnect()
			animConn = nil
		end
		animators = {}
		task.spawn(function()
			pcall(function()
				local char = player.Character
				local a = char and char:FindFirstChild("Animate")
				if a then
					a.Enabled = false
					task.wait()
					a.Enabled = true
				end
			end)
		end)
	end,
}

globals.effects = {
	on = function()
		set("effects", Lighting, "GlobalShadows", false)
		set("effects", terrain, "WaterReflectance", 0)
		pcall(function()
			local r = settings().Rendering
			savedQuality = r.QualityLevel
			r.QualityLevel = Enum.QualityLevel.Level01
		end)
	end,
	off = function()
		pcall(function()
			if savedQuality then
				settings().Rendering.QualityLevel = savedQuality
			end
		end)
		savedQuality = nil
	end,
}

globals.motion = {
	on = function()
		set("motion", terrain, "WaterWaveSize", 0)
		set("motion", terrain, "WaterWaveSpeed", 0)
	end,
	off = function() end,
}

globals.everything = {
	on = function()
		set("everything", Lighting, "Ambient", WHITE)
		set("everything", Lighting, "OutdoorAmbient", WHITE)
		set("everything", Lighting, "FogColor", WHITE)
		set("everything", terrain, "WaterColor", WHITE)
		terrainColors = {}
		for _, m in Enum.Material:GetEnumItems() do
			pcall(function()
				terrainColors[m] = terrain:GetMaterialColor(m)
				terrain:SetMaterialColor(m, WHITE)
			end)
		end
	end,
	off = function()
		if terrainColors then
			for m, c in terrainColors do
				pcall(function()
					terrain:SetMaterialColor(m, c)
				end)
			end
			terrainColors = nil
		end
	end,
}

local function scan(f, g)
	local h = handlers[f]
	local n = 0
	for _, root in { Workspace, Lighting } do
		for _, inst in root:GetDescendants() do
			if not active[f] or gen[f] ~= g then
				return
			end
			pcall(h, inst)
			n += 1
			if n % 400 == 0 then
				task.wait()
			end
		end
	end
end

local function activate(f)
	active[f] = true
	gen[f] += 1
	local g = gen[f]
	globals[f].on()
	task.spawn(scan, f, g)
end

local function deactivate(f)
	active[f] = false
	gen[f] += 1
	for inst, rec in saved[f] do
		for prop, val in rec do
			pcall(function()
				inst[prop] = val
			end)
		end
	end
	saved[f] = {}
	for inst, parent in parked[f] do
		pcall(function()
			inst.Parent = parent
		end)
	end
	parked[f] = {}
	globals[f].off()
end

local function onAdded(inst)
	for _, f in FEATURES do
		if active[f] then
			pcall(handlers[f], inst)
		end
	end
end
Workspace.DescendantAdded:Connect(onAdded)
Lighting.DescendantAdded:Connect(onAdded)


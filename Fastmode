				end
			end
		end)
	end,
	off = function()
		if animConn then
			animConn:Disconnect()
			animConn = nil
		end
		animators = {}
		task.spawn(function()
			pcall(function()
				local char = player.Character
				local a = char and char:FindFirstChild("Animate")
				if a then
					a.Enabled = false
					task.wait()
					a.Enabled = true
				end
			end)
		end)
	end,
}

